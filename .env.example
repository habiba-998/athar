# Copy to .env (never commit .env). Every value below is a placeholder or a safe default; no real secret belongs in this file.

# ---- mode ---------------------------------------------------------------------------------------------------------
# local : private instance. With ATHAR_API_TOKEN unset only loopback clients are accepted; with it set every /api call needs it.
# demo  : PUBLIC read-only demonstration. Visitors may read and run stateless simulations; all writes need ATHAR_ADMIN_TOKEN.
ATHAR_MODE=local

# ---- secrets (generate: python -c "import secrets; print(secrets.token_urlsafe(32))") ------------------------------
# At least 16 characters; the two must differ. A demo refuses to start with weak values.
ATHAR_API_TOKEN=
ATHAR_ADMIN_TOKEN=

# ---- network ------------------------------------------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API from a DIFFERENT origin (no wildcards). Not needed when the
# API serves the single-page app itself.
ATHAR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to 1 ONLY behind exactly one trusted reverse proxy that appends the client address to X-Forwarded-For.
ATHAR_TRUST_PROXY=0
# Extra https origins the page may connect to (CSP connect-src), space separated; only for a split frontend/API deployment.
ATHAR_CSP_CONNECT=
ATHAR_HSTS=0
# 1 (with ATHAR_TRUST_PROXY=1) redirects requests that the proxy reports as plain http to https. Health/readiness probes are exempt.
ATHAR_FORCE_HTTPS=0
# Space separated https origins allowed to embed the app in a frame (default: nobody). Hugging Face shows Spaces inside an iframe.
ATHAR_FRAME_ANCESTORS=

# ---- data and files -----------------------------------------------------------------------------------------------
ATHAR_DB=backend/data/athar.db
# Directory with the built frontend (index.html). Defaults to frontend/dist when it exists.
ATHAR_STATIC_DIR=

# ---- limits -------------------------------------------------------------------------------------------------------
ATHAR_RATE_READ=300
ATHAR_RATE_WRITE=90
ATHAR_RATE_EXPLAIN=40
ATHAR_MAX_BODY=1048576
ATHAR_LOG_LEVEL=INFO
# 1 re-enables /docs and /openapi.json in demo mode.
ATHAR_DOCS=0

# ---- optional AI narration (off unless both are set; never creates findings) ---------------------------------------
ATHAR_AI_PROVIDER=
ANTHROPIC_API_KEY=
ATHAR_AI_MODEL=
