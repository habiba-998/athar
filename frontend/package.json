{
    "name": "athar-frontend",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "build:static": "node scripts/prepare-pyodide.mjs && tsc -b && vite build --mode static --outDir dist-static && node scripts/write-headers.mjs",
        "preview:static": "vite preview --outDir dist-static --host 127.0.0.1 --port 5185 --strictPort",
        "lint": "eslint src",
        "format": "prettier --write src",
        "test": "vitest run",
        "e2e": "playwright test"
    },
    "dependencies": {
        "@fontsource/ibm-plex-mono": "^5.3.0",
        "@fontsource/ibm-plex-sans": "^5.3.0",
        "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
        "@xyflow/react": "^12.12.1",
        "pyodide": "314.0.7",
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.65.0",
        "@tailwindcss/vite": "^4.3.5",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "eslint": "^10.14.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "prettier": "^3.9.10",
        "tailwindcss": "^4.3.5",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.6",
        "vitest": "^5.1.0"
    },
    "overrides": {
        "minimatch": "^11.0.5"
    }
}
