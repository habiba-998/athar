# Build-time settings for the single-page app (Vite). These values are compiled into the public bundle, so NEVER put a
# secret here.
#
# Empty (default): the app calls /api on the same origin that served it (single-service deployment or the Vite dev proxy).
# For a split deployment set the API's public https origin, with no trailing slash, e.g.:
#   VITE_API_BASE=https://api.example.org
# and list the frontend's origin in the API's ATHAR_CORS_ORIGINS.
VITE_API_BASE=
